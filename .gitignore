# macOS
.DS_Store
**/.DS_Store

# Cloud-sync (iCloud/Dropbox) duplicate-conflict copies, e.g. "jun02_2026 1/"
*\ 1/
*\ 1.*
*\ [0-9]/

# Local scratch
files.zip

# Large video assets — exceed GitHub's 100MB limit; Meta can't fetch them via CDN. Host elsewhere.
*.mp4
*.MP4
*.mov
*.MOV

# Signed certification docs contain third-party PII (signer email/IP) — keep local only
07-Project_info/certifications/

# Comic source panels — 7-12MB PNGs, four per weekly episode. Only the composited
# carousel_N.jpg slides are ever published; the panels are intermediates that were
# adding ~50MB/week to the repo forever. Existing tracked panels are left in place;
# run `git rm --cached <path>` if you want them out of the working tree too.
panel_*.png

# Intermediate h264 transcodes — the original mp4 is already ignored above
*_h264.mp4
